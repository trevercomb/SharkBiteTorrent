# Packages the prebuilt Linux release tarball (built by .github/workflows/release.yml).
# Put the release tarball next to this file, then: makepkg -si
pkgname=sharkbitetorrent
# The app's version; a beta (0.3.0-beta.1) becomes pkgver 0.3.0beta.1, since
# pacman versions can't contain "-" (and sort 0.3.0beta.1 before 0.3.0).
_version=0.2.40
pkgver=${_version//-/}
pkgrel=1
pkgdesc="Lightweight BitTorrent client with a built-in per-app VPN (WARP/WireGuard)"
arch=('x86_64')
url="https://github.com/trevercomb/SharkBiteTorrent"
license=('GPL-3.0-or-later')
depends=('gtk3' 'webkit2gtk-4.1' 'xdg-utils')
optdepends=(
  'kwallet: stores the encryption key for saved VPN logins (KDE)'
  'gnome-keyring: stores the encryption key for saved VPN logins (GNOME and others)'
)
source=("SharkBiteTorrent-${_version}-linux-x86_64.tar.gz")
sha256sums=('SKIP')
# The binary is already stripped, so skip makepkg's empty -debug split package.
options=('!debug')

package() {
  cd "SharkBiteTorrent-${_version}-linux-x86_64"
  install -Dm755 SharkBiteTorrent "${pkgdir}/usr/bin/sharkbitetorrent"
  install -Dm644 sharkbitetorrent.desktop "${pkgdir}/usr/share/applications/sharkbitetorrent.desktop"
  install -Dm644 sharkbitetorrent.png "${pkgdir}/usr/share/pixmaps/sharkbitetorrent.png"
  install -Dm644 THIRD_PARTY_LICENSES.txt "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_LICENSES.txt"
}
