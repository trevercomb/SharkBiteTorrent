{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "SharkBiteTorrent",
  "outputfilename": "SharkBiteTorrent",
  "frontend:install": "npm ci --ignore-scripts",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "trevercomb",
    "email": "6431088+trevercomb@users.noreply.github.com"
  },
  "info": {
    "productName": "Shark BiteTorrent",
    "productVersion": "0.2.40",
    "copyright": "Copyright (C) 2026 Shark BiteTorrent contributors. Licensed under GPL-3.0-or-later.",
    "comments": "BitTorrent client with a built-in per-app VPN",
    "fileAssociations": [
      {
        "ext": "torrent",
        "name": "BitTorrent file",
        "description": "Torrent file",
        "iconName": "appicon",
        "role": "Viewer"
      }
    ],
    "protocols": [
      {
        "scheme": "magnet",
        "description": "Magnet link",
        "role": "Viewer"
      }
    ]
  }
}
